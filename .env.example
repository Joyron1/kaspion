# Copy to .env.local for local development. On Vercel: Project → Settings → Environment Variables.

# Supabase (texts, recordings, play-time stats). Without these the game runs on the texts in code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Parent login for /editor
ADMIN_PASSWORD=
AUTH_SECRET=            # long random string: openssl rand -hex 32

# Optional cloud narrator voice: azure | google | openai | elevenlabs
TTS_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=he-IL-HilaNeural
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=he-IL-Wavenet-A
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# Optional: automatic nikud (Dicta Nakdan). Defaults to Dicta's public endpoint.
DICTA_NAKDAN_URL=
DICTA_API_KEY=
